# ── SHIFT Coaching API — copy to apps/api/.env (or set in your host/orchestrator) ──

# PostgreSQL 14+ connection string (required)
DATABASE_URL=postgres://shift:shift@localhost:5432/shift

# HTTP
PORT=4000
# HOST=0.0.0.0
NODE_ENV=development
# Set to true when running behind a reverse proxy / load balancer (rate limits use X-Forwarded-For)
# TRUST_PROXY=true

# Signs the session cookie. REQUIRED in production, 32+ random chars: `openssl rand -hex 32`
COOKIE_SECRET=

# Public base URL of this server. Prefixed to upload URLs; leave empty when web + API share one origin in production.
# In development (Vite on another port) set it to the API origin so uploaded images load.
PUBLIC_URL=http://localhost:4000

# Only needed if the web app is served from a DIFFERENT origin than the API (comma separated origins)
# CORS_ORIGIN=https://www.shiftwithedel.com

# Uploaded images/PDFs (relative paths resolve from apps/api). Mount a persistent volume here in production.
UPLOAD_DIR=./uploads

# Email: SMTP connection URL. Without it, queued emails are marked "logged" and printed to the console (not delivered).
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="SHIFT Coaching <hello@shiftwithedel.com>"
# Outbox polling interval in ms (0 disables the worker)
# EMAIL_POLL_MS=15000

# Serve the built SPA (npm run build → apps/web/dist) from this server, with history fallback
# WEB_DIST=../web/dist

# Pin "today" for demos so seeded schedules line up (core setToday). Leave empty in production.
# DEMO_TODAY=2026-09-28T08:30:00+04:00

# Seeding (npm run db:seed)
# SEED_DEMO=true
# SEED_ADMIN_PASSWORD=shift-admin-2026
# SEED_CLIENT_PASSWORD=shift-client-2026

# Core formats session times / "today" in the server's local timezone — run the API in the coach's zone
# TZ=Asia/Dubai

# bcrypt cost factor (default 12)
# BCRYPT_ROUNDS=12
# LOG_LEVEL=info
# PAYMENT_PROVIDER=manual
